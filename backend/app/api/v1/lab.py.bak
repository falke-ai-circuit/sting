from fastapi import APIRouter, HTTPException, Query
from pydantic import BaseModel
from typing import Optional, List, Dict, Any
from datetime import datetime
import json
import logging

from app.core.db import get_conn

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/lab", tags=["lab"])


class LabSnapshotIn(BaseModel):
    session_id: str
    source_ip: str
    created_at: str
    writes: Dict[str, str]  # hex encoded
    commands: List[Dict[str, Any]]
    reads: List[str]


@router.get("/snapshots")
async def list_snapshots(
    limit: int = Query(50, le=200),
    offset: int = Query(0, ge=0),
    source_ip: Optional[str] = None,
):
    """List all LAB snapshots."""
    
    if source_ip:
        rows = await get_conn().fetch("""
            SELECT * FROM lab_snapshots 
            WHERE source_ip = $1
            ORDER BY created_at DESC 
            LIMIT $2 OFFSET $3
        """, source_ip, limit, offset)
    else:
        rows = await get_conn().fetch("""
            SELECT * FROM lab_snapshots 
            ORDER BY created_at DESC 
            LIMIT $1 OFFSET $2
        """, limit, offset)
    
    snapshots = []
    for r in rows:
        s = dict(r)
        s["id"] = str(s["id"])
        if s.get("created_at"):
            s["created_at"] = s["created_at"].isoformat()
        # Parse JSON fields
        if s.get("writes"):
            s["writes"] = json.loads(s["writes"]) if isinstance(s["writes"], str) else s["writes"]
        if s.get("commands"):
            s["commands"] = json.loads(s["commands"]) if isinstance(s["commands"], str) else s["commands"]
        if s.get("reads"):
            s["reads"] = json.loads(s["reads"]) if isinstance(s["reads"], str) else s["reads"]
        snapshots.append(s)
    
    return {"snapshots": snapshots, "total": len(snapshots), "offset": offset}


@router.get("/snapshots/{snapshot_id}")
async def get_snapshot(snapshot_id: str):
    """Get a specific LAB snapshot by ID."""
    
    row = await get_conn().fetchrow("""
        SELECT * FROM lab_snapshots WHERE id = $1::uuid
    """, snapshot_id)
    
    if not row:
        raise HTTPException(404, "Snapshot not found")
    
    s = dict(row)
    s["id"] = str(s["id"])
    if s.get("created_at"):
        s["created_at"] = s["created_at"].isoformat()
    # Parse JSON fields
    if s.get("writes"):
        s["writes"] = json.loads(s["writes"]) if isinstance(s["writes"], str) else s["writes"]
    if s.get("commands"):
        s["commands"] = json.loads(s["commands"]) if isinstance(s["commands"], str) else s["commands"]
    if s.get("reads"):
        s["reads"] = json.loads(s["reads"]) if isinstance(s["reads"], str) else s["reads"]
    
    return s


@router.post("/snapshots")
async def create_snapshot(snapshot: LabSnapshotIn):
    """Store a new LAB snapshot."""
    
    # Convert writes dict to JSON string for storage
    writes_json = json.dumps(snapshot.writes)
    commands_json = json.dumps(snapshot.commands)
    reads_json = json.dumps(snapshot.reads)
    
    snapshot_id = await get_conn().fetchval("""
        INSERT INTO lab_snapshots (
            session_id, source_ip, writes, commands, reads, created_at
        ) VALUES ($1, $2, $3, $4, $5, NOW())
        RETURNING id
    """, snapshot.session_id, snapshot.source_ip, writes_json, commands_json, reads_json)
    
    logger.info(f"Stored LAB snapshot for session {snapshot.session_id}")
    
    return {
        "status": "stored",
        "id": str(snapshot_id),
        "session_id": snapshot.session_id
    }


@router.delete("/snapshots/{snapshot_id}")
async def delete_snapshot(snapshot_id: str):
    """Delete a LAB snapshot."""
    
    result = await get_conn().execute("""
        DELETE FROM lab_snapshots WHERE id = $1::uuid
    """, snapshot_id)
    
    if result == "DELETE 0":
        raise HTTPException(404, "Snapshot not found")
    
    return {"status": "deleted", "id": snapshot_id}
